{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fishing-bucket-website",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "routes": [
    {
      "pattern": "fishingbucket.org",
      "custom_domain": true
    }
  ]
}